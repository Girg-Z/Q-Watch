<?xml version="1.0" encoding="utf-8"?>
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />

    <Scene backgroundColor="#000000">

        <!-- ================================================================
             SLOT 0 — arc + artist (RANGED_VALUE)
               value = set progress 0-100
               text  = stage hex color e.g. "#0BDBEF"
               title = artist name

             Arc is rendered at SCENE level because endAngle arithmetic
             expressions only work at Scene level, not inside a Complication
             context. Stroke color uses [COMPLICATION_0.TEXT] cross-slot.

             Artist name is rendered INSIDE this slot's own Complication
             context using [COMPLICATION.TEXT/TITLE] (own-slot), where Font
             color expressions are confirmed to work.
             ================================================================ -->
        <ComplicationSlot
            slotId="0"
            supportedTypes="RANGED_VALUE"
            name="now_playing"
            isCustomizable="FALSE"
            x="0" y="0" width="450" height="450">
            <BoundingBox x="0" y="0" width="450" height="450" />
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="RANGED_VALUE"
                primaryProvider="dev.girg.qwatch/dev.girg.qwatch.complication.NowPlayingComplicationService"
                primaryProviderType="RANGED_VALUE" />
            <Complication type="RANGED_VALUE">
                <!-- Artist name — stage color (own-slot Font color confirmed working) -->
                <PartText x="0" y="172" width="450" height="68">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="52" color="[COMPLICATION.TEXT]" weight="BOLD">
                            <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
                        </Font>
                    </Text>
                </PartText>
                <!-- Arc track — full circle at 16% opacity -->
                <PartDraw x="18" y="18" width="414" height="414" alpha="41">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Arc centerX="207" centerY="207" width="414" height="414"
                        direction="CLOCKWISE" startAngle="0" endAngle="360">
                        <Stroke cap="ROUND" color="[COMPLICATION.TEXT]" thickness="13" />
                    </Arc>
                </PartDraw>
                <!-- Arc fill — progress sweep, full opacity -->
                <PartDraw x="18" y="18" width="414" height="414">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Arc centerX="207" centerY="207" width="414" height="414"
                        direction="CLOCKWISE" startAngle="0.0" endAngle="0.0">
                        <Stroke cap="ROUND" color="[COMPLICATION.TEXT]" thickness="13" />
                        <Transform
                            target="endAngle"
                            value="[COMPLICATION.RANGED_VALUE_VALUE] * 3.6" />
                    </Arc>
                </PartDraw>
                <!-- Arc fill — ambient, thin stroke at 30% opacity -->
                <PartDraw x="18" y="18" width="414" height="414" alpha="0">
                    <Variant mode="AMBIENT" target="alpha" value="77" />
                    <Arc centerX="207" centerY="207" width="414" height="414"
                        direction="CLOCKWISE" startAngle="0.0" endAngle="0.0">
                        <Stroke cap="ROUND" color="[COMPLICATION.TEXT]" thickness="3" />
                        <Transform
                            target="endAngle"
                            value="[COMPLICATION.RANGED_VALUE_VALUE] * 3.6" />
                    </Arc>
                </PartDraw>
            </Complication>
        </ComplicationSlot>

        <!-- ================================================================
             SLOT 1 — countdown (SHORT_TEXT): "37M LEFT" or ""
             ================================================================ -->
        <ComplicationSlot
            slotId="1"
            supportedTypes="SHORT_TEXT"
            name="countdown"
            isCustomizable="FALSE"
            x="0" y="0" width="450" height="450">
            <BoundingBox x="0" y="0" width="450" height="450" />
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="SHORT_TEXT"
                primaryProvider="dev.girg.qwatch/dev.girg.qwatch.complication.CountdownComplicationService"
                primaryProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="303" width="450" height="20">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="13" color="#B4B4B4">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ================================================================
             SLOT 2 — next artist (SHORT_TEXT): "NEXT · Name" or ""
             ================================================================ -->
        <ComplicationSlot
            slotId="2"
            supportedTypes="SHORT_TEXT"
            name="next_artist"
            isCustomizable="FALSE"
            x="0" y="0" width="450" height="450">
            <BoundingBox x="0" y="0" width="450" height="450" />
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="SHORT_TEXT"
                primaryProvider="dev.girg.qwatch/dev.girg.qwatch.complication.NextArtistComplicationService"
                primaryProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="330" width="450" height="20">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="14" color="#B4B4B4">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ================================================================
             SLOT 3 — next favourite set (SHORT_TEXT): "★ Headhunterz" or ""
               Small, secondary line near the top of the face. Its tap box is
               sized to this line (and kept non-overlapping with the other
               slots) so tapping the favourite name opens the wear app on the
               Favourites screen (tap action is attached to the complication
               data itself).
             ================================================================ -->
        <ComplicationSlot
            slotId="3"
            supportedTypes="SHORT_TEXT"
            name="next_favourite"
            isCustomizable="FALSE"
            x="0" y="0" width="450" height="450">
            <!-- Tap target = the "★ artist" line itself; tapping it opens the Favourites screen. -->
            <BoundingBox x="40" y="82" width="370" height="62" />
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="SHORT_TEXT"
                primaryProvider="dev.girg.qwatch/dev.girg.qwatch.complication.NextFavouriteComplicationService"
                primaryProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="104" width="450" height="22">
                    <Variant mode="AMBIENT" target="alpha" value="0" />
                    <Text align="CENTER">
                        <Font family="SYNC_TO_DEVICE" size="16" color="#E0C24A">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- ================================================================
             CLOCK — active mode (hidden in ambient)
             ================================================================ -->
        <DigitalClock x="0" y="252" width="450" height="48">
            <TimeText format="hh:mm" hourFormat="24" align="CENTER"
                      x="0" y="0" width="450" height="48">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Font family="SYNC_TO_DEVICE" size="36" color="#E6E6E6" />
            </TimeText>
        </DigitalClock>

        <!-- CLOCK — ambient mode (large THIN, hidden in active) -->
        <DigitalClock x="0" y="175" width="450" height="100">
            <TimeText format="hh:mm" hourFormat="24" align="CENTER"
                      x="0" y="0" width="450" height="100" alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255" />
                <Font family="SYNC_TO_DEVICE" size="80" color="#FFFFFF" weight="THIN" />
            </TimeText>
        </DigitalClock>
    </Scene>
</WatchFace>
